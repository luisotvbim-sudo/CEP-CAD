<Window x:Class="PluginConceito.Modules.InsertNotes.InsertNotesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inserir Notas"
        Width="520" Height="540"
        MinWidth="380" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#F08F38" />
        <SolidColorBrush x:Key="TextBrush" Color="#243038" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65747D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C0C0C0" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Inserir Notas"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,12" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Level0}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked}"
                              Margin="4,3"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="13"
                              VerticalContentAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}"
                Margin="0,8,0,4"
                Visibility="{Binding HasLevel1, Converter={StaticResource BoolToVis}}" />

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Level1}"
                      Visibility="{Binding HasLevel1, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked}"
                              Margin="4,3"
                              Foreground="{StaticResource AccentBrush}"
                              FontSize="13"
                              VerticalContentAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" Height="1" Background="{StaticResource BorderBrush}"
                Margin="0,8,0,4"
                Visibility="{Binding HasLevel2, Converter={StaticResource BoolToVis}}" />

        <ItemsControl Grid.Row="5" ItemsSource="{Binding Level2}"
                      Visibility="{Binding HasLevel2, Converter={StaticResource BoolToVis}}"
                      Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked}"
                              Margin="4,3"
                              Foreground="{StaticResource MutedBrush}"
                              FontSize="12"
                              VerticalContentAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="6" Height="1" Background="{StaticResource BorderBrush}"
                Margin="0,20,0,8" />

        <TextBlock Grid.Row="7"
                   Text="Etapa de Projeto"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,8" />

        <ItemsControl Grid.Row="8" ItemsSource="{Binding Stages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked}"
                              Margin="4,3"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="13"
                              VerticalContentAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="9" Height="1" Background="{StaticResource BorderBrush}"
                Margin="0,16,0,8" />

        <TextBlock Grid.Row="10"
                   Text="Importancia"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,8" />

        <ItemsControl Grid.Row="11" ItemsSource="{Binding Importance}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked}"
                              Margin="4,3"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="13"
                              VerticalContentAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="12"
                   Text="SELECIONE AS NOTAS OPCIONAIS"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,10,0,8"
                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />

        <TextBox Grid.Row="13"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 BorderBrush="{StaticResource BorderBrush}"
                 Margin="0,0,0,6"
                 Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                 FontSize="12"
                 Foreground="{StaticResource TextBrush}" />

        <ListBox Grid.Row="14" ItemsSource="{Binding Notes}"
                 BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                 Margin="0,0,0,0" MaxHeight="130"
                 Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                 AlternationCount="2">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F2F2F2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked}"
                              Margin="6,4"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="12" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="15"
                Content="BUSCAR NOTAS"
                Width="160" Height="36"
                HorizontalAlignment="Center"
                Margin="0,10,0,8"
                Background="{StaticResource AccentBrush}"
                Foreground="White"
                FontSize="14" FontWeight="SemiBold"
                BorderThickness="0"
                Cursor="Hand"
                Click="OnBuscarNotasClick" />
    </Grid>
</Window>
