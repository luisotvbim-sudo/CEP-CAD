<Window x:Class="PluginConceito.Modules.PlotFolhas.PlotFolhasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="CNT · Plotar folhas"
        Width="1160" Height="740" MinWidth="940" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/PlotFolhasTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderContainer}"
                Margin="0,0,0,8"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="34"
                       Height="34"
                       Source="/PluginConceito;component/03-Modules/PlotFolhas/Resources/Logo_Versao_Reduzida.png"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="CNT" />
                <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Plotar folhas"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding SourceSubtitle}"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="ORIGEM"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{StaticResource SubtleBrush}" />
                        <Border CornerRadius="3,0,0,3">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource OriginSegment}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelSpace}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="MODEL" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelSpace}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="0,3,3,0" Margin="-1,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource OriginSegment}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelSpace}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="LAYOUT" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelSpace}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding SourceDetail}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content=""
                            Style="{StaticResource IconButton}"
                            Click="RefreshClick"
                            Margin="0,0,7,0"
                            ToolTip="Atualizar folhas e informações do Model ou Layout ativo" />
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="FOLHAS" Style="{StaticResource SummaryLabel}" />
                            <TextBlock Text="{Binding SheetCollection.TotalCount}" Style="{StaticResource SummaryValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="PDF" Style="{StaticResource SummaryLabel}" />
                            <TextBlock Text="{Binding SheetCollection.PdfCount}" Style="{StaticResource SummaryValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="DWG" Style="{StaticResource SummaryLabel}" />
                            <TextBlock Text="{Binding SheetCollection.DwgCount}" Style="{StaticResource SummaryValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="ALERTAS" Style="{StaticResource SummaryLabel}" />
                            <TextBlock Text="{Binding SheetCollection.IssueCount}"
                                       Style="{StaticResource SummaryValue}"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="0,0,0,9">
            <Expander Header="Estrutura de nomenclatura" Padding="10,7" IsExpanded="False">
                <Grid Margin="0,7,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Monte um padrão e aplique a todas as folhas. O nome individual continua editável na tabela." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding NamingStructure.Parts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBox Width="58" MaxLength="6" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="Campo do nome" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,3,0,0">
                                                    <CheckBox Content="S"
                                                              IsChecked="{Binding IsSequential}"
                                                              FontSize="9"
                                                              ToolTip="Campo sequencial" />
                                                    <CheckBox Content="R"
                                                              IsChecked="{Binding IsRevision}"
                                                              FontSize="9"
                                                              Margin="7,0,0,0"
                                                              ToolTip="Campo de revisão" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataContext.NamingStructure.Separator, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Margin="4,5,4,0"
                                                       VerticalAlignment="Top"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Separador" Margin="6,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="SeparatorTextBox"
                                     Width="38"
                                     Height="28"
                                     Padding="3,1"
                                     MaxLength="1"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryPressedBrush}"
                                     Background="{StaticResource PrimarySoftBrush}"
                                     BorderBrush="{StaticResource PrimaryBrush}"
                                     CaretBrush="{StaticResource PrimaryPressedBrush}"
                                     Text="{Binding NamingStructure.Separator, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="SelectAllTextBoxContent"
                                     PreviewMouseLeftButtonDown="SelectAllTextBoxOnFirstClick"
                                     ToolTip="Digite um caractere para separar as partes do nome." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="− campo" Style="{StaticResource CompactButton}" Click="RemoveNamingPartClick" Margin="0,0,5,0" />
                        <Button Content="+ campo" Style="{StaticResource CompactButton}" Click="AddNamingPartClick" Margin="0,0,8,0" />
                        <Button Content="Aplicar a todas" Style="{StaticResource TonalButton}" Click="ApplyStructuredNameClick" />
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SectionBorder}"
                Margin="0,0,0,9"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Panel.ZIndex="2" />
                    <TextBox Grid.ColumnSpan="2"
                              Padding="33,5,9,5"
                             Text="{Binding SheetCollection.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Pesquisar por número, formato, nome ou status" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="11,0,14,0">
                    <CheckBox Content="Alertas"
                              IsChecked="{Binding SheetCollection.ShowOnlyIssues}" />
                    <CheckBox Content="Revisões"
                              IsChecked="{Binding SheetCollection.ShowOnlyRevisionUpdates}"
                              Margin="12,0,0,0" />
                    <CheckBox Content="Selecionados"
                              IsChecked="{Binding SheetCollection.ShowOnlySelectedOutputs}"
                              Margin="12,0,0,0"
                              ToolTip="Mostrar folhas com PDF ou DWG marcado" />
                </StackPanel>
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="10"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource MutedBrush}">
                        <Run Text="Exibindo "/><Run Text="{Binding SheetCollection.VisibleCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" folha(s)"/>
                    </TextBlock>
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <CheckBox Content="PDF"
                              IsChecked="{Binding SheetCollection.AllPdfSelected}"
                              ToolTip="Marcar ou desmarcar PDF em todas as folhas"
                              Margin="0,0,12,0" />
                    <CheckBox Content="DWG"
                              IsChecked="{Binding SheetCollection.AllDwgSelected}"
                              ToolTip="Marcar ou desmarcar DWG em todas as folhas" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionBorder}" ClipToBounds="True">
            <DataGrid x:Name="SheetsGrid"
                      ItemsSource="{Binding SheetCollection.View}"
                      SelectedItem="{Binding SelectedSheet}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="True" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="34" AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="PDF"
                                            Binding="{Binding Plotar, UpdateSourceTrigger=PropertyChanged}"
                                            Width="50"
                                            HeaderStyle="{StaticResource DataGridCenteredColumnHeader}"
                                            ElementStyle="{StaticResource DataGridCenteredCheckBox}"
                                            EditingElementStyle="{StaticResource DataGridCenteredCheckBox}" />
                    <DataGridCheckBoxColumn Header="DWG"
                                            Binding="{Binding GerarDwg, UpdateSourceTrigger=PropertyChanged}"
                                            Width="54"
                                            HeaderStyle="{StaticResource DataGridCenteredColumnHeader}"
                                            ElementStyle="{StaticResource DataGridCenteredCheckBox}"
                                            EditingElementStyle="{StaticResource DataGridCenteredCheckBox}" />
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding Sequencia}"
                                        IsReadOnly="True"
                                        Width="44"
                                        HeaderStyle="{StaticResource DataGridCenteredColumnHeader}"
                                        ElementStyle="{StaticResource DataGridCenteredTextCell}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextCell}" />
                    <DataGridTextColumn Header="Formato"
                                        Binding="{Binding Formato}"
                                        IsReadOnly="True"
                                        Width="72"
                                        HeaderStyle="{StaticResource DataGridCenteredColumnHeader}"
                                        ElementStyle="{StaticResource DataGridCenteredTextCell}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextCell}" />
                    <DataGridTemplateColumn Header="Revisão"
                                            Width="70"
                                            HeaderStyle="{StaticResource DataGridCenteredColumnHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding SubirRevisao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DataGridCenteredCheckBox}"
                                          Tag="{Binding}"
                                          Click="RevisionSheetClick"
                                          ToolTip="Incrementar automaticamente o campo de revisão desta folha" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nome do arquivo"
                                        Binding="{Binding NomeArquivo, UpdateSourceTrigger=LostFocus}"
                                        Width="*"
                                        MinWidth="240"
                                        ElementStyle="{StaticResource DataGridTextCell}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextCell}" />
                    <DataGridTemplateColumn Header="Situação" Width="215">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Status}"
                                               Style="{StaticResource DataGridTextCell}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="66" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Zoom"
                                        Style="{StaticResource CompactButton}"
                                        Tag="{Binding}"
                                        Click="ZoomSheetClick"
                                        ToolTip="{Binding DataContext.ZoomToolTip, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource SectionBorder}" Margin="0,9,0,9" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <Border Width="24" Height="24" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5">
                        <TextBlock Text=""
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource PrimaryPressedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Configuração de saída" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Defina destino, plotter e padrão de impressão." FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Pasta" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding Output.OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Se esta pasta não for alterada, será criada automaticamente uma subpasta Emissão NN." />
                <Button Grid.Column="2" Content="Escolher…" Style="{StaticResource TonalButton}" Click="BrowseFolderClick" Margin="6,0,14,0" />
                <TextBlock Grid.Column="3" Text="CTB / STB" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Output.PlotStyles}" SelectedItem="{Binding Output.CtbName}" />

                <TextBlock Grid.Row="1" Text="Plotter" VerticalAlignment="Center" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Output.Devices}" SelectedItem="{Binding Output.DeviceName}" Margin="0,7,0,0" />
                <CheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="Sobrescrever arquivos existentes" IsChecked="{Binding Output.OverwriteExisting}" VerticalAlignment="Center" Margin="0,7,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource SectionBorder}" Margin="0,0,0,9">
            <Expander Header="Copiar nome para selo" Padding="10,7" IsExpanded="False">
                <Grid Margin="0,7,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bloco" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StampSelection.BlockNames}"
                              SelectedItem="{Binding StampSelection.SelectedBlock}"
                              SelectionChanged="OnStampBlockSelectionChanged"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ToolTip="Escolha o bloco de selo que contém o atributo a preencher." />
                    <TextBlock Grid.Column="2" Text="Atributo" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox Grid.Column="3"
                              x:Name="StampAttributeCombo"
                              ItemsSource="{Binding StampSelection.Attributes}"
                              SelectedItem="{Binding StampSelection.SelectedAttribute, Mode=TwoWay}"
                              ToolTip="Escolha qual atributo do selo receberá o nome de cada folha." />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                               Text="Ao salvar ou gerar, o nome vai para o atributo selecionado."
                               Margin="0,8,10,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button Grid.Row="1" Grid.Column="3"
                            Content="Usar atributo nos nomes"
                            Style="{StaticResource TonalButton}"
                            Click="LoadNamesFromStampClick"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            ToolTip="Lê esse atributo do bloco correspondente dentro de cada folha e usa seu valor como nome do arquivo." />
                </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="11,8"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="4"
                            Margin="0,0,8,0" />
                    <ProgressBar Width="62" Height="4" IsIndeterminate="True" Margin="0,0,8,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Salvar nomenclatura"
                        Click="SaveNamesClick"
                         Margin="8,0"
                         MinWidth="150" />
                <Button Grid.Column="2"
                        Content="{Binding GenerateButtonText}"
                        Click="PlotClick"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="7" Background="{StaticResource OverlayBrush}" Panel.ZIndex="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Border Style="{StaticResource BusyCard}"
                    Padding="24,19"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Width="310">
                    <Border Width="40" Height="40"
                            Background="{StaticResource PrimarySoftBrush}"
                            CornerRadius="9"
                            HorizontalAlignment="Center">
                        <TextBlock Text=""
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Processando arquivos"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <ProgressBar Height="5" IsIndeterminate="True" Margin="0,13,0,9" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
