<Window x:Class="PluginConceito.Modules.PlotFolhas.PlotFolhasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="CNT · Plotar folhas"
        Width="1240" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="13"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#F08F38" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9F40" />
        <SolidColorBrush x:Key="TextBrush" Color="#243038" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65747D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C0C0C0" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="155" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF1F3" />
            <Setter Property="Foreground" Value="#46545C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderBrush" Value="#DCE3E7" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#E7ECEF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="ToolTip" Value="{Binding Status}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Valida}" Value="False">
                    <Setter Property="Background" Value="#FFF2F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Plotar folhas" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Revise, nomeie e gere os arquivos do layout ativo." Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Atualizar" Click="RefreshClick" Margin="0,0,10,0" ToolTip="Recarrega as folhas e informações do layout ativo." />
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Folhas  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SheetCollection.TotalCount}" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="PDF  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SheetCollection.PdfCount}" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="DWG  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SheetCollection.DwgCount}" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}" Margin="0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Alertas  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SheetCollection.IssueCount}" FontWeight="Bold" Foreground="#A35718"/></StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="0,0,0,10">
            <Expander Header="Estrutura de nomenclatura" Padding="12,9" IsExpanded="False">
                <Grid Margin="0,10,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Monte um padrão e aplique a todas as folhas. O nome individual continua editável na tabela." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding NamingStructure.Parts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBox Width="72" MaxLength="6" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="Campo do nome" />
                                                <CheckBox IsChecked="{Binding IsSequential}" HorizontalAlignment="Center" FontSize="10" Margin="0,4,0,0" ToolTip="Numeração sequencial">Seq</CheckBox>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataContext.NamingStructure.Separator, RelativeSource={RelativeSource AncestorType=Window}}" Margin="5,7,5,0" VerticalAlignment="Top" FontWeight="Bold" Foreground="#F08F38" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Separador" Margin="8,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Width="38" MaxLength="1" TextAlignment="Center" Text="{Binding NamingStructure.Separator, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="− campo" Click="RemoveNamingPartClick" Margin="0,0,6,0" />
                        <Button Content="+ campo" Click="AddNamingPartClick" Margin="0,0,10,0" />
                        <Button Content="Aplicar a todas" Click="ApplyStructuredNameClick" />
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SheetCollection.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar por número, formato, nome ou status" />
            <CheckBox Grid.Column="1" Content="Somente alertas" IsChecked="{Binding SheetCollection.ShowOnlyIssues}" VerticalAlignment="Center" Margin="12,0,18,0" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                <Run Text="Exibindo "/><Run Text="{Binding SheetCollection.VisibleCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" folha(s)"/>
            </TextBlock>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="PDF: todas" Click="SelectAllPdfClick" Margin="0,0,6,0" />
                <Button Content="PDF: nenhuma" Click="ClearAllPdfClick" Margin="0,0,12,0" />
                <Button Content="DWG: todas" Click="SelectAllDwgClick" Margin="0,0,6,0" />
                <Button Content="DWG: nenhuma" Click="ClearAllDwgClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SectionBorder}">
            <DataGrid x:Name="SheetsGrid"
                      ItemsSource="{Binding SheetCollection.View}"
                      SelectedItem="{Binding SelectedSheet}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="True" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="39" AlternatingRowBackground="#FAFBFC"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0"
                      CellEditEnding="OnCellEditEnding">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="PDF" Binding="{Binding Plotar, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                    <DataGridCheckBoxColumn Header="DWG" Binding="{Binding GerarDwg, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                    <DataGridTextColumn Header="#" Binding="{Binding Sequencia}" IsReadOnly="True" Width="52" />
                    <DataGridTextColumn Header="Formato" Binding="{Binding Formato}" IsReadOnly="True" Width="85" />
                    <DataGridTextColumn Header="Nome do arquivo" Binding="{Binding NomeArquivo, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="280" />
                    <DataGridTemplateColumn Header="Situação" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#596870" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="76" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Zoom" Padding="9,4" Tag="{Binding}" Click="ZoomSheetClick" ToolTip="Aproximar esta folha no layout" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource SectionBorder}" Margin="0,10,0,10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Pasta" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding Output.OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Se esta pasta não for alterada, será criada automaticamente uma subpasta Emissão NN." />
                <Button Grid.Column="2" Content="Escolher…" Click="BrowseFolderClick" Margin="7,0,18,0" />
                <TextBlock Grid.Column="3" Text="CTB / STB" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Output.PlotStyles}" SelectedItem="{Binding Output.CtbName}" />

                <TextBlock Grid.Row="1" Text="Plotter" VerticalAlignment="Center" Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Output.Devices}" SelectedItem="{Binding Output.DeviceName}" Margin="0,9,0,0" />
                <CheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="Sobrescrever arquivos existentes" IsChecked="{Binding Output.OverwriteExisting}" VerticalAlignment="Center" Margin="0,9,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource SectionBorder}" Margin="0,0,0,10" Padding="12">
            <Expander Header="Copiar nome para selo" Padding="12,9" IsExpanded="False">
                <Grid Margin="0,10,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bloco" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StampSelection.BlockNames}"
                              SelectedItem="{Binding StampSelection.SelectedBlock}"
                              SelectionChanged="OnStampBlockSelectionChanged"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              ToolTip="Escolha o bloco de selo que contém o atributo a preencher." />
                    <TextBlock Grid.Column="2" Text="Atributo" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox Grid.Column="3"
                              x:Name="StampAttributeCombo"
                              ItemsSource="{Binding StampSelection.Attributes}"
                              SelectedItem="{Binding StampSelection.SelectedAttribute, Mode=TwoWay}"
                              ToolTip="Escolha qual atributo do selo receberá o nome de cada folha." />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                               Text="Ao salvar ou gerar, o nome vai para o atributo selecionado."
                               Margin="0,10,12,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button Grid.Row="1" Grid.Column="3"
                            Content="Usar atributo nos nomes"
                            Click="LoadNamesFromStampClick"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            ToolTip="Lê esse atributo do bloco correspondente dentro de cada folha e usa seu valor como nome do arquivo." />
                </Grid>
            </Expander>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Width="80" Height="5" IsIndeterminate="True" Margin="0,0,10,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Content="Salvar nomenclatura" Click="SaveNamesClick" Margin="10,0" MinWidth="175" />
            <Button Grid.Column="2" Content="Gerar arquivos" Click="PlotClick" Style="{StaticResource PrimaryButton}" />
        </Grid>

        <Border Grid.RowSpan="7" Background="#60FFFFFF" Panel.ZIndex="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Width="340">
                    <TextBlock Text="Processando arquivos" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <ProgressBar Height="6" IsIndeterminate="True" Margin="0,14,0,10" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
